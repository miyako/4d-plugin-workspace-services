#!/bin/sh
set -eu

count=0
while read -r local_ref local_sha remote_ref remote_sha; do
    count=$((count + 1))
    if [ "$remote_ref" != "$BUMP_EXPECTED_REF" ] ||
       [ "$remote_sha" != "$BUMP_EXPECTED_SHA" ] ||
       [ "$local_sha" != "$BUMP_NEW_SHA" ] ||
       { [ "$local_ref" != "$BUMP_NEW_SHA" ] && [ "$local_ref" != HEAD ]; } ||
       [ "$(git rev-parse HEAD)" != "$BUMP_NEW_SHA" ] ||
       [ "$(git rev-list --parents -n 1 "$local_sha")" != "$BUMP_NEW_SHA $BUMP_EXPECTED_SHA" ]; then
        echo "Bump rejected: advertised branch state differs from selected SHA/ref." >&2
        exit 1
    fi
done

# Git omits up-to-date refs from hook input; reject a same-result race too.
if [ "$count" -ne 1 ]; then
    echo "Bump rejected: expected exactly one advertised branch update." >&2
    exit 1
fi
